{
  "datasets": [
    "../test_samples/tasks.jsonl"
  ],
  "methods": [
    "baseline",
    "question_weighted_kv",
    "question_attention_reconstruction",
    "oracle_private_prefix_distillation"
  ],
  "base_loss": "token",
  "lambda_attention": 1.0,
  "attention_loss_version": 2,
  "weighted_kv_version": 2,
  "semantic_query_mode": "structured",
  "semantic_query_weights": {
    "object_state": 0.25,
    "target_field": 0.3,
    "required_value": 0.2,
    "question": 0.25
  },
  "save_topk": 50,
  "checkpoint_metric": "base",
  "answer_boundary": "Answer: ",
  "stop_strings": [
    "\n"
  ],
  "max_new_tokens": 16,
  "score_probability": "accepted_forms",
  "output_dir": "/data/kevin/fluoroscopy/results",
  "experiment_version": 2,
  "answer_leading_spaces": [
    0,
    1
  ],
  "output_instruction": "Output only the requested answer in English. No labels, numbering, explanation, or extra text.",
  "weighted_kv_context_version": 2,
  "weighted_kv_normalization_version": 2
}
